# ---- Contact form / email configuration ----
# The address that receives messages submitted via the website contact form.
CONTACT_EMAIL=hello@jayanthtechnologies.com

# ---- Resend (https://resend.com) transactional email provider ----
# Used by /api/contact.js on the server. NEVER expose this in frontend code.
RESEND_API_KEY=re_your_api_key_here

# Verified "from" address in Resend (must be on a domain you have verified)
RESEND_FROM=Jayanth Technologies <no-reply@jayanthtechnologies.com>
